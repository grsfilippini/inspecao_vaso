<%= render partial: 'admins_backoffice/relatorios/shared/antes_form_inspecao' %>

                       
                        <%= form_with(model: [ :admins_backoffice, @relatorio ], local: true, :html => { :multipart => true }) do |form| %>
                            
                            <%= render partial: 'admins_backoffice/relatorios/shared/botoes_navegacao' %>                            
                            
                            <div class="form-group row">
                                <div class="form-check col-sm-6 mb-0 mb-sm-0 d-inline">
                                    <%= form.check_box :bpressostato_existe, class: "form-check-input", id: "ExistePressostatoCheckbox" %>
                                    <%= form.label :bpressostato_existe, "Existe pressostato", class: "form-check-label", for: "ExistePressostatoCheckbox" %>
                                </div>
                            </div>
                            
                            <div class="form-group row">
                                <div class="form-check col-sm-6 mb-0 mb-sm-0 d-inline">
                                    <%= form.check_box :bpressostato_ehmantido_calibrado_eemboas_condicoes_operacao, class: "form-check-input", id: "PressostatoManCalCheckbox" %>
                                    <%= form.label :bpressostato_ehmantido_calibrado_eemboas_condicoes_operacao, "É mantido calibrado e em boas condições", class: "form-check-label", for: "PressostatoManCalCheckbox" %>
                                </div>
                            </div>
                            
                            <div class="form-group row">
                                <div class="form-check col-sm-6 mb-0 mb-sm-0 d-inline">
                                    <%= form.check_box :bpressostato_foisubstituido, class: "form-check-input", id: "PressostatoSubsCheckbox" %>
                                    <%= form.label :bpressostato_foisubstituido, "Foi substituido/instalado", class: "form-check-label orange-label", for: "PressostatoSubsCheckbox" %>
                                </div>
                            </div>                            
                            <div class="form-group row">
                                <div class="form-check col-sm-6 mb-0 mb-sm-0 d-inline">
                                    <%= form.check_box :bpressostato_foifeito_ajuste, class: "form-check-input", id: "PressostatoFeitoAjusteCheckbox" %>
                                    <%= form.label :bpressostato_foifeito_ajuste, "Foi feito ajuste", class: "form-check-label orange-label", for: "PressostatoFeitoAjusteCheckbox" %>
                                </div>
                            </div>
                            
                            

                            <div class="form-group row">
                                <div class="form-check col-sm-6 mb-0 mb-sm-0 d-inline">
                                    <%= form.check_box :bpressostato_foiverificada_faixadetrabalho,
                                        class: "form-check-input",
                                        id: "PressostatoVerifFaixaCheckbox" %>

                                    <%= form.label :bpressostato_foiverificada_faixadetrabalho,
                                        "Foi verificada a faixa de trabalho",
                                        class: "form-check-label orange-label",
                                        for: "PressostatoVerifFaixaCheckbox" %>
                                </div>
                            </div>

                            <div class="form-group row">
                                <%= form.label :pmta_atual, 'PMTA atual',
                                    class: "col-sm-2 col-form-label text-sm-left text-lg-right red-label" %>

                                <div class="col-sm-4 mb-2 mb-sm-0 d-flex align-items-center">
                                    <span>
                                        <%= number_with_precision(@relatorio.vaso.pmta_atual, precision: 3) %> MPa
                                        &nbsp;(
                                        <%= number_with_precision(@relatorio.vaso.pmta_atual.to_f * 145.0377377, precision: 0) %> psi
                                        )
                                    </span>
                                </div>
                            </div>

                            <div class="form-group row">
                                <%= form.label :dispositivoseg_pabertura, 'Pressão de abertura',
                                    class: "col-sm-2 col-form-label text-sm-left text-lg-right red-label" %>

                                <div class="col-sm-2 mb-2 mb-sm-0 d-flex align-items-center">
                                    <span><%= number_with_precision(@relatorio.dispositivoseg_pabertura, precision: 3) %> MPa</span>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-sm-6 mb-3 mb-sm-0">
                                    <%= form.label :pressostato_pliga, "Pressão liga", class: "red-label" %>

                                    <%= form.number_field :pressostato_pliga,
                                        step: 0.001,
                                        min: -10,
                                        required: false,
                                        style: 'width: 100px;',
                                        disabled: !@relatorio.bpressostato_foiverificada_faixadetrabalho?,
                                        id: "object_pressostato_pliga" %>

                                    [MPa]
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-sm-6 mb-3 mb-sm-0">
                                    <%= form.label :pressostato_pdesliga, "Pressão desliga", class: "red-label" %>

                                    <%= form.number_field :pressostato_pdesliga,
                                        step: 0.001,
                                        min: -10,
                                        required: false,
                                        style: 'width: 100px;',
                                        disabled: !@relatorio.bpressostato_foiverificada_faixadetrabalho?,
                                        id: "object_pressostato_pdesliga" %>

                                    [MPa]
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-sm-6 mb-3 mb-sm-0">
                                    <label for="pressostato_tipo" class="red-label">Tipo de pressostato</label>

                                    <select id="pressostato_tipo"
                                            class="form-control form-control-sm"
                                            style="width: 200px;"
                                            disabled="<%= !@relatorio.bpressostato_foiverificada_faixadetrabalho? %>">

                                        <option value="">Selecione</option>
                                        <option value="baixa">De baixa (80-120 psi)</option>
                                        <option value="media">De média (100-140 psi)</option>
                                        <option value="alta">De alta (125-175 psi)</option>

                                    </select>
                                </div>
                            </div>
                            
                            <script>
                                document.addEventListener("DOMContentLoaded", function() {
                                    const checkbox = document.getElementById("PressostatoVerifFaixaCheckbox");
                                    const pligaInput = document.getElementById("object_pressostato_pliga");
                                    const pdesligaInput = document.getElementById("object_pressostato_pdesliga");
                                    const tipoSelect = document.getElementById("pressostato_tipo");

                                    const fatorConversao = 0.006894757293;

                                    const faixas = {
                                        baixa: { liga: 80, desliga: 120 },
                                        media: { liga: 100, desliga: 140 },
                                        alta:  { liga: 125, desliga: 175 }
                                    };

                                    function atualizarEstadoCampos() {
                                        const habilitado = checkbox.checked;

                                        pligaInput.disabled = !habilitado;
                                        pdesligaInput.disabled = !habilitado;
                                        tipoSelect.disabled = !habilitado;
                                    }

                                    tipoSelect.addEventListener("change", function() {
                                        const faixa = faixas[this.value];

                                        if (faixa) {
                                            pligaInput.value = (faixa.liga * fatorConversao).toFixed(3);
                                            pdesligaInput.value = (faixa.desliga * fatorConversao).toFixed(3);
                                        }
                                    });

                                    // Ao alterar manualmente qualquer pressão, limpar a seleção do combo.
                                    pligaInput.addEventListener("input", function() {
                                        tipoSelect.selectedIndex = 0;
                                    });

                                    pdesligaInput.addEventListener("input", function() {
                                        tipoSelect.selectedIndex = 0;
                                    });

                                    checkbox.addEventListener("change", atualizarEstadoCampos);

                                    atualizarEstadoCampos();
                                });
                            </script>




                                          
                            <div class="form-group row">                                
                                <%= form.label :pressostato_observacoes, 'Obs.', {class: "col-sm-1 col-form-label text-sm-left text-lg-right"} %>
                                <div class="form-check col-sm-6 mb-0 mb-sm-0">
                                    <%= form.text_field :pressostato_observacoes, class: "form-control"  %>
                                </div>
                            </div>
                                
                           
                            
                            <hr>
                            
                            <br> <br>
                            
                            <%= button_tag "Gravar e Voltar", type: "submit", class: "btn btn-primary", name: "btn_insp_dispseg" %>
                            <%= button_tag "Gravar e Sair", type: "submit", class: "btn btn-primary", name: "btn_gravar_sair" %>
                            <%= button_tag "Gravar e Avançar", type: "submit", class: "btn btn-primary", name: "btn_insp_vaso_outros" %>
                                                        
                        <% end %>                                                                     

